    "pluralize": "^8.0.0",
    "pusher-js": "^8.6.0",
    "tinymce": "^8.4.0",
    "vuetify": "^3.11.8"
  },
  "name": "efomento",
  "version": "1.0.0",
  "description": "Sistema web de gerenciamento de processos de fomento cultural da **Secretaria da Cultura do Ceará (SECULT-CE)**, construído em Laravel 13.",
