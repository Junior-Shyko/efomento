    "autoprefixer": "^10.4.12",
    "axios": "^1.11.0",
    "concurrently": "^9.0.1",
    "cypress": "^15.11.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.1",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^2.0.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.31",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.2.1",
    "vite": "^7.3.1",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.2.9",
